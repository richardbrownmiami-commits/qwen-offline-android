<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Temperature (creativity)"
            android:textStyle="bold" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderTemp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.0"
            android:valueTo="1.5"
            android:stepSize="0.05"
            android:value="0.7" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Top-P (nucleus sampling)"
            android:textStyle="bold" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderTopP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.1"
            android:valueTo="1.0"
            android:stepSize="0.05"
            android:value="0.9" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Repeat Penalty"
            android:textStyle="bold" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderPenalty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1.0"
            android:valueTo="1.5"
            android:stepSize="0.05"
            android:value="1.1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Max Generation Tokens (e.g. 96 - 256)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editMaxTokens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="128" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Context Window Size (tokens, recommended 512 for 32-bit)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editContext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="512" />
    </LinearLayout>
</ScrollView>
